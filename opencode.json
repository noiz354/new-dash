{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key={env:FIGMA_PAT}",
        "--stdio"
      ],
      "enabled": true,
      "environment": {
        "FRAMELINK_TELEMETRY": "off"
      }
    }
  }
}
